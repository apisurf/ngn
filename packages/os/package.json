{
  "name": "@apisurf/ngn-os",
  "version": "0.2.4",
  "description": "ngn filesystem and process helpers: task discovery, watching, config and signals.",
  "type": "module",
  "author": "Luka Vidakovic",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apisurf/ngn.git",
    "directory": "packages/os"
  },
  "homepage": "https://github.com/apisurf/ngn#readme",
  "bugs": {
    "url": "https://github.com/apisurf/ngn/issues"
  },
  "keywords": [
    "ngn",
    "scheduler",
    "tasks"
  ],
  "main": "./dist/os.js",
  "types": "./dist/os.d.ts",
  "exports": {
    ".": {
      "import": "./dist/os.js",
      "types": "./dist/os.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/os.ts --dts --out-dir dist --format esm",
    "dev": "tsup src/os.ts --dts --out-dir dist --format esm --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "debug": "^4.4.1",
    "dotenv": "^17.2.1",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.8.1",
    "tsup": "^8.3.5"
  }
}
