{
  "name": "@apisurf/ngn-plugins",
  "private": true,
  "version": "0.1.0",
  "description": "Official plugins for @apisurf/ngn",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --dts --out-dir dist --format esm",
    "dev": "tsup src/index.ts --dts --out-dir dist --format esm --watch"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "ngn-core": "workspace:*",
    "tsup": "^8.3.5"
  }
}
