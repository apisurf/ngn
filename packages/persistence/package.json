{
  "name": "@apisurf/ngn-persistence",
  "version": "0.2.1",
  "description": "ngn SQLite persistence: connection pragmas, migrations and the client.",
  "type": "module",
  "author": "Luka Vidakovic",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apisurf/ngn.git",
    "directory": "packages/persistence"
  },
  "homepage": "https://github.com/apisurf/ngn#readme",
  "bugs": {
    "url": "https://github.com/apisurf/ngn/issues"
  },
  "keywords": [
    "ngn",
    "scheduler",
    "tasks"
  ],
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/client.ts --dts --out-dir dist --format esm",
    "dev": "tsup src/client.ts --dts --out-dir dist --format esm --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apisurf/ngn-os": "workspace:*",
    "@libsql/client": "^0.14.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsup": "^8.3.5"
  }
}
