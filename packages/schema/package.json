{
  "name": "@apisurf/ngn-schema",
  "version": "0.2.4",
  "description": "ngn database schema: zod definitions for the tables ngn reads and writes.",
  "type": "module",
  "author": "Luka Vidakovic",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apisurf/ngn.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/apisurf/ngn#readme",
  "bugs": {
    "url": "https://github.com/apisurf/ngn/issues"
  },
  "keywords": [
    "ngn",
    "scheduler",
    "tasks"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --out-dir dist --format esm",
    "dev": "tsup src/index.ts --dts --out-dir dist --format esm --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsup": "^8.3.5"
  }
}
