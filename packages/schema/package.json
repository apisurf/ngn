{
  "name": "@apisurf/ngn-schema",
  "version": "0.3.0",
  "description": "ngn database schema: zod definitions for the tables ngn reads and writes, and how their rows read in words.",
  "type": "module",
  "author": "Luka Vidakovic",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apisurf/ngn.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/apisurf/ngn#readme",
  "bugs": {
    "url": "https://github.com/apisurf/ngn/issues"
  },
  "keywords": [
    "ngn",
    "scheduler",
    "tasks"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./describe": {
      "types": "./dist/describe/index.d.ts",
      "import": "./dist/describe/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/describe/index.ts --dts --out-dir dist --format esm",
    "dev": "tsup src/index.ts src/describe/index.ts --dts --out-dir dist --format esm --watch",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsup": "^8.3.5",
    "vitest": "4.1.8"
  }
}
