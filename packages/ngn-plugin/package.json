{
  "name": "@apisurf/ngn-plugin",
  "version": "0.1.16",
  "description": "Official plugin library for @apisurf/ngn",
  "author": "Luka Vidakovic",
  "keywords": [
    "ngn",
    "plugin",
    "sqlite",
    "alerting",
    "supabase",
    "automation"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/apisurf/ngn.git",
    "directory": "packages/ngn-plugins"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "exports": {
    "./sqlite": {
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    },
    "./alerting": {
      "import": "./dist/alerting.js",
      "types": "./dist/alerting.d.ts"
    },
    "./resend": {
      "import": "./dist/resend.js",
      "types": "./dist/resend.d.ts"
    },
    "./supabase": {
      "import": "./dist/supabase.js",
      "types": "./dist/supabase.d.ts"
    },
    "./s3": {
      "import": "./dist/s3.js",
      "types": "./dist/s3.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@libsql/client": "^0.14.0",
    "@supabase/supabase-js": "^2.49.1",
    "resend": "^6.7.0"
  },
  "peerDependencies": {
    "@apisurf/ngn": ">=0.1.16"
  },
  "devDependencies": {
    "@apisurf/ngn": "workspace:*",
    "@types/node": "^22.8.1",
    "ngn-core": "workspace:*",
    "tsup": "^8.3.5"
  }
}
