{
  "name": "@apisurf/ngnui",
  "version": "0.0.1",
  "description": "ngnui — browse an ngn run database in a local web UI: tasks, runs, logs, timings, stored keys, versions, plus a live task editor.",
  "keywords": [
    "cron",
    "dashboard",
    "ngn",
    "scheduler",
    "sqlite",
    "tasks",
    "viewer"
  ],
  "homepage": "https://github.com/apisurf/ngn/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/apisurf/ngn/issues"
  },
  "license": "ISC",
  "author": "Luka Vidakovic (https://github.com/apisurfer)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apisurf/ngn.git",
    "directory": "packages/ui"
  },
  "bin": {
    "ngnui": "./bin/ngnui.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "panda codegen --silent && vite build",
    "start": "node ./bin/ngnui.mjs",
    "typecheck": "panda codegen --silent && tsgo --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "prepare": "panda codegen --silent"
  },
  "dependencies": {
    "better-sqlite3": "11.7.0"
  },
  "devDependencies": {
    "@apisurf/ngn-persistence": "workspace:*",
    "@pandacss/dev": "1.12.1",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.6.3",
    "vite": "8.3.1",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
