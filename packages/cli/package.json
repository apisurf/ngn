{
  "name": "@op3/cli",
  "version": "0.1.3",
  "bin": {
    "op3": "dist/cli.js"
  },
  "scripts": {
    "copy-spa": "mkdir -p ./dist/ui && cp -R node_modules/op3-ui/dist/* ./dist/ui",
    "dev": "tsup --watch",
    "build": "tsup && pnpm copy-spa",
    "inject-deps": "node scripts/inject-dependencies.js"
  },
  "author": "Luka Vidakovic",
  "description": "CLI scheduler for Node tasks. Automate and monitor Javascript and Typescript tasks.",
  "keywords": [
    "cli",
    "scheduler",
    "cron",
    "task",
    "automation",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "commander": "^12.1.0",
    "glob": "^11.0.3",
    "node-cron": "^3.0.3",
    "outmatch": "^1.0.0",
    "tiny-invariant": "^1.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/node-cron": "^3.0.11",
    "op3-core": "workspace:*",
    "op3-api": "workspace:*",
    "op3-os": "workspace:*",
    "op3-persistence": "workspace:*",
    "op3-ui": "workspace:*",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "types": "./src/cli.d.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src/cli.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
