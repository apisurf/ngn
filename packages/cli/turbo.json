{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "op3-core#build",
        "op3-api#build",
        "op3-os#build",
        "op3-persistence#build",
        "op3-ui#build"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": [
        "op3-core#build",
        "op3-api#build",
        "op3-os#build",
        "op3-persistence#build"
      ],
      "persistent": true,
      "cache": false
    }
  }
}
